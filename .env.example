# Образец .env.local. Ключи в репозиторий не коммитить (.env* в .gitignore).

# ── Бэкенд ──
# Адрес API. Пусто — весь сайт работает на моке (lib/mock.ts).
NEXT_PUBLIC_API_URL=
# Функции lib/api.ts, которые пока остаются на моке, через запятую (* — все). Пример: getOrders,getBonus
NEXT_PUBLIC_API_MOCK=

# ── Сайт ──
# Канонический адрес: canonical, sitemap, Open Graph. Пример: https://8mart.kz
NEXT_PUBLIC_SITE_URL=
# Если сайт открывается не с корня домена. Пример: /shop
NEXT_PUBLIC_BASE_PATH=

# ── Карта и адреса ──
# Mapbox, публичный pk.* (браузер; ограничить доменами в кабинете Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Mapbox для обратного геокодинга на сервере (запасной вариант к DaData)
MAPBOX_TOKEN=
# DaData — только на сервере (app/api/geo/*). Временный адаптер до GET /geo/* бэкенда.
DADATA_API_KEY=
DADATA_SECRET=
